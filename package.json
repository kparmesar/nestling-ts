{
  "name": "nestling-ts",
  "version": "0.1.0",
  "description": "TypeScript client, CLI, and local MCP server for the Nestling baby tracking app",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
      "nestling": "dist/cli/cli.js",
      "nestling-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "cli": "npm run build --silent && node dist/cli/cli.js",
    "nestling": "npm run build --silent && node dist/cli/cli.js",
    "mcp": "npm run build --silent && node dist/mcp/server.js",
    "dev:cli": "bun run src/cli/cli.ts",
    "dev:mcp": "bun run src/mcp/server.ts",
    "test": "bun test",
    "lint": "tsc --noEmit -p tsconfig.build.json",
    "format": "prettier --write src/",
    "prepack": "npm run build"
  },
  "keywords": [
    "nestling",
    "baby",
    "sleep",
    "tracking",
    "cli",
    "mcp",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@supabase/supabase-js": "^2.49.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.14",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kparmesar/nestling-ts.git"
  },
  "homepage": "https://github.com/kparmesar/nestling-ts#readme",
  "bugs": {
    "url": "https://github.com/kparmesar/nestling-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
